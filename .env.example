# Copy to .env next to compose.yaml and change what you need.
# Everything has a default, so an empty .env (or none) works.

# Port on the host for the app.
LIFTLOG_PORT=3070

# Port for the hot-reload dev server (docker compose --profile dev up --build dev)
LIFTLOG_DEV_PORT=3071

# Container time zone, for log timestamps. Workout dates always follow Pacific
# time (PDT/PST) whatever this is set to.
TZ=America/Vancouver

# Contact sent with lock-screen alerts (https://... or mailto:...). Leave it out:
# Liftlog uses the HTTPS address you open it on, e.g. https://liftlog.example.com
# PUSH_SUBJECT=mailto:you@example.com
